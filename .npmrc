# Netlify runs its own `npm install` during the "Installing dependencies"
# stage, before the build command in netlify.toml. Flags on that command
# therefore never reach the install that actually matters — this file is the
# only place a setting applies to every npm invocation, local and CI alike.
#
# Why it's needed: package-lock.json isn't committed (see .gitignore), so each
# build resolves from scratch. package.json asks for vue-router ^5.0.6, which
# floats to 5.2.0, and 5.2.0 declares peers on pinia / @pinia/colada / vite
# that this project doesn't have. npm 10.9.8 crashes building that peer graph
# rather than reporting the conflict:
#   npm error Cannot read properties of null (reading 'edgesOut')
#
# Reproducible locally with the same npm version from package.json alone.
legacy-peer-deps=true
