{
  "indexes": [
    {
      "comment": "Seller payout query: /api/payouts/request filters by seller, method and status.",
      "collectionGroup": "compiledOrders",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "sellerUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "paymentMethod",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "POS reservation sweeper: releaseExpiredReservations filters inventory by owner and status.",
      "collectionGroup": "inventory",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Notification feed: a user's notifications, newest first.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Notification cleanup: a user's notifications read before a cutoff.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "readAt",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "collectionGroup": "notifications",
      "fieldPath": "expireAt",
      "ttl": true,
      "indexes": []
    }
  ]
}
